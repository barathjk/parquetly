{
  "name": "parquetly",
  "displayName": "Parquetly - Parquet Viewer and Editor",
  "description": "Parquet viewer and editor for VS Code. Open .parquet, .pq and .parq files as a fast, searchable, sortable, editable data table with charts and SQL-style filters.",
  "version": "0.1.2",
  "publisher": "barathjk",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Data Science",
    "Visualization"
  ],
  "keywords": [
    "parquet",
    "parquet viewer",
    "parquet editor",
    "parquet reader",
    "parquet file",
    "pq",
    "parq",
    "apache arrow",
    "columnar",
    "dataframe",
    "data preview",
    "table viewer",
    "csv",
    "big data",
    "data science"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:parquetly.parquetEditor"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "parquetly.parquetEditor",
        "displayName": "Parquetly",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          },
          {
            "filenamePattern": "*.pq"
          },
          {
            "filenamePattern": "*.parq"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "parquetly.openFile",
        "title": "Parquetly: Open Parquet File"
      }
    ]
  },
  "icon": "images/icon_v2.png",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/barathjk/parquetly.git"
  },
  "bugs": {
    "url": "https://github.com/barathjk/parquetly/issues"
  },
  "homepage": "https://github.com/barathjk/parquetly#readme",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "vsce:package": "vsce package --no-dependencies",
    "pretest": "npm run package",
    "test": "node test/run-all.mjs"
  },
  "dependencies": {
    "hyparquet": "^1.7.0",
    "hyparquet-writer": "^0.16.9"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.2.2",
    "jsdom": "^30.0.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  }
}
